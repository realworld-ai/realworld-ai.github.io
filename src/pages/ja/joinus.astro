---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import joinData from "../../data/join.json";
import { UserPlus, Mail, ArrowRight, CheckCircle, Zap, Users, Book } from "lucide-react";

const lang = "ja";
const pageData = joinData[lang];
---

<Layout title="採用情報・見学 | Real-world Intelligence Lab" lang={lang}>
  <!-- Hero Section -->
  <section class="relative w-full h-screen bg-gradient-to-br from-lab-blue via-slate-900 to-black flex items-center justify-center overflow-hidden pt-20">
    <div class="absolute inset-0 opacity-30">
      <div class="absolute w-96 h-96 bg-lab-blue/20 rounded-full blur-3xl top-10 left-10"></div>
      <div class="absolute w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl bottom-20 right-20"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 py-20 text-center">
      <h1 class="text-5xl md:text-6xl font-bold text-white mb-6 leading-tight">
        {pageData.hero.title}
      </h1>
      <p class="text-xl md:text-2xl text-gray-300 mb-12 leading-relaxed max-w-3xl mx-auto">
        {pageData.hero.subtitle}
      </p>
      <a href="#why_join" class="inline-flex items-center gap-2 bg-lab-blue hover:bg-lab-blue/90 text-white px-8 py-4 rounded-lg font-semibold transition-colors">
        {pageData.hero.cta_label}
      </a>
    </div>
  </section>

  <!-- Main Content -->
  <div class="pb-20 max-w-7xl mx-auto px-4 py-16 space-y-20">
    <!-- Why Join Section -->
    <section id="why_join" class="scroll-mt-24">
      <h2 class="text-4xl font-bold mb-12 text-center text-white">
        {pageData.why_join.title}
      </h2>
      <div class="grid md:grid-cols-3 gap-8">
        {pageData.why_join.benefits.map((benefit) => (
          <div class="bg-gradient-to-br from-gray-800 to-gray-900 rounded-xl p-8 border border-gray-700/50 hover:border-lab-blue/50 transition-colors group">
            <h3 class="text-xl font-bold text-white mb-4">{benefit.title}</h3>
            <p class="text-gray-400 leading-relaxed">{benefit.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Who We Welcome Section -->
    <section id="who_welcome" class="scroll-mt-24">
      <h2 class="text-4xl font-bold mb-12 text-center text-white">
        {pageData.who_we_welcome.title}
      </h2>
      <div class="grid md:grid-cols-2 gap-8">
        {pageData.who_we_welcome.profiles.map((profile) => (
          <div class="bg-gradient-to-br from-gray-800 to-gray-900 rounded-xl p-8 border border-gray-700/50 hover:border-lab-blue/50 transition-colors">
            <h3 class="text-2xl font-bold text-lab-blue mb-4">{profile.title}</h3>
            <p class="text-gray-300 leading-relaxed mb-6">{profile.description}</p>
            <a href={profile.cta_link_text === "現在の募集" ? "#recruitment" : "#contact"} class="inline-flex items-center gap-2 text-lab-blue hover:text-lab-blue/80 font-semibold transition-colors">
              {profile.cta_link_text}
            </a>
          </div>
        ))}
      </div>
    </section>

    {/* Research Snapshot Section - Hidden
    {pageData.research_snapshot.cards && pageData.research_snapshot.cards.length > 0 && (
      <section id="research" class="scroll-mt-24">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-bold text-white mb-4">
            {pageData.research_snapshot.title}
          </h2>
          {pageData.research_snapshot.description && (
            <p class="text-xl text-gray-400 max-w-2xl mx-auto">
              {pageData.research_snapshot.description}
            </p>
          )}
        </div>
        <div class="grid md:grid-cols-2 gap-8">
          {pageData.research_snapshot.cards.map((card) => (
            <div class="bg-gradient-to-br from-lab-blue/10 to-cyan-500/10 rounded-xl p-8 border border-lab-blue/20 hover:border-lab-blue/50 transition-colors">
              <h3 class="text-xl font-bold text-lab-blue mb-3">{card.title}</h3>
              <p class="text-gray-300 leading-relaxed">{card.description}</p>
            </div>
          ))}
        </div>
      </section>
    )}
    */}

    {/* How to Join Section - Hidden
    <section id="how_join" class="scroll-mt-24">
      <h2 class="text-4xl font-bold mb-12 text-center text-white">
        {pageData.how_to_join.title}
      </h2>
      <div class="space-y-8">
        {pageData.how_to_join.steps.map((step, index) => (
          <div class="flex gap-8">
            <div class="flex flex-col items-center">
              <div class="w-12 h-12 bg-lab-blue text-white rounded-full flex items-center justify-center font-bold text-lg">
                {step.step_number}
              </div>
              {index < pageData.how_to_join.steps.length - 1 && (
                <div class="w-1 h-16 bg-gradient-to-b from-lab-blue to-gray-700 mt-4"></div>
              )}
            </div>
            <div class="pb-8">
              <h3 class="text-2xl font-bold text-white mb-2">{step.title}</h3>
              <p class="text-gray-400 leading-relaxed">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
    */}

    {/* FAQ Section - Moved to end
    {pageData.faq && pageData.faq.faqs.length > 0 && (
      <section id="faq" class="scroll-mt-24">
        <h2 class="text-4xl font-bold mb-12 text-center text-white">
          {pageData.faq.title}
        </h2>
        <div class="max-w-3xl mx-auto space-y-4">
          {pageData.faq.faqs.map((faq) => (
            <details class="group bg-gradient-to-r from-gray-800 to-gray-900 rounded-lg border border-gray-700/50 hover:border-lab-blue/50 transition-colors p-6 cursor-pointer">
              <summary class="flex items-start gap-4 font-bold text-white text-lg hover:text-lab-blue transition-colors">
                <span class="mt-1 flex-shrink-0">
                  <CheckCircle className="w-5 h-5 text-lab-blue group-open:hidden" />
                  <ArrowRight className="w-5 h-5 text-lab-blue hidden group-open:block transform rotate-90" />
                </span>
                <span>{faq.question}</span>
              </summary>
              <p class="text-gray-400 leading-relaxed mt-4 ml-9">{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )}
    */}

    <!-- Final CTA Section -->
    {pageData.final_cta && (
      <section id="final-cta" class="scroll-mt-24 text-center py-16 bg-gradient-to-r from-lab-blue/10 to-cyan-500/10 rounded-2xl border border-lab-blue/20 px-8">
        <h2 class="text-4xl font-bold text-white mb-8">
          {pageData.final_cta.title}
        </h2>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          {pageData.final_cta.button_primary_url && (
            <a href={pageData.final_cta.button_primary_url} class="inline-flex items-center justify-center gap-2 bg-lab-blue hover:bg-lab-blue/90 text-white px-8 py-3 rounded-lg font-semibold transition-colors">
              {pageData.final_cta.button_primary_text}
            </a>
          )}
          {pageData.final_cta.button_secondary_url && (
            <a href={pageData.final_cta.button_secondary_url} class="inline-flex items-center justify-center gap-2 bg-gray-800 hover:bg-gray-700 text-white px-8 py-3 rounded-lg font-semibold transition-colors border border-gray-700">
              {pageData.final_cta.button_secondary_text}
            </a>
          )}
        </div>
      </section>
    )}

    <!-- Recruitment Section -->
    <section id="recruitment" class="scroll-mt-24">
      <h2 class="text-3xl font-bold mb-8 text-lab-blue">
        {pageData.recruitment.title}
      </h2>

      <div class="">
        <p class="text-lg text-gray-400 mb-6">{pageData.recruitment.description}</p>

        {
          pageData.recruitment.jobs && pageData.recruitment.jobs.length > 0 ? (
            <div class="space-y-8">
              {pageData.recruitment.jobs.map((job) => (
                <div class="border-l-4 border-lab-blue p-6 bg-gray-50/5 border border-gray-700/30 rounded-r-lg hover:bg-gray-800/20 transition-colors">
                  <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2 mb-4">
                    <h3 class="text-xl font-bold text-white">{job.title}</h3>
                    {job.number && (
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-lab-blue/10 text-lab-blue border border-lab-blue/20">
                        採用予定人数: {job.number}
                      </span>
                    )}
                  </div>
                  
                  <div class="space-y-4 text-gray-300">
                    {Array.isArray(job.description) ? (
                      job.description.map((desc) => <p class="leading-relaxed">{desc}</p>)
                    ) : (
                      <p class="leading-relaxed">{job.description}</p>
                    )}
                  </div>

                  {job.attachment && (
                    <div class="mt-6 pt-4 border-t border-gray-700/50">
                      <a 
                        href={job.attachment}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 text-lab-blue hover:text-lab-blue/80 transition-colors bg-lab-blue/5 hover:bg-lab-blue/10 px-4 py-2 rounded-lg"
                      >
                        応募要項（PDF）のダウンロード
                      </a>
                    </div>
                  )}
                </div>
              ))}
            </div>
          ) : (
            <div class="text-center py-12 bg-gray-800 rounded-lg border border-dashed border-gray-700">
              <p class="text-gray-500 italic text-lg">{pageData.recruitment.no_openings}</p>
            </div>
          )
        }
      </div>
    </section>

    <!-- FAQ Section -->
    {pageData.faq && pageData.faq.faqs.length > 0 && (
      <section id="faq" class="scroll-mt-24">
        <h2 class="text-4xl font-bold mb-12 text-center text-white">
          {pageData.faq.title}
        </h2>
        <div class="max-w-3xl mx-auto space-y-4">
          {pageData.faq.faqs.map((faq) => (
            <details class="group bg-gradient-to-r from-gray-800 to-gray-900 rounded-lg border border-gray-700/50 hover:border-lab-blue/50 transition-colors p-6 cursor-pointer">
              <summary class="flex items-start gap-4 font-bold text-white text-lg hover:text-lab-blue transition-colors">
                <span class="mt-1 flex-shrink-0">
                  <span class="text-lab-blue group-open:hidden">[+]</span>
                  <span class="text-lab-blue hidden group-open:block">[-]</span>
                </span>
                <span>{faq.question}</span>
              </summary>
              <p class="text-gray-400 leading-relaxed mt-4 ml-9">{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    {/* Visit / Collaboration Section - Hidden
    <section id="contact" class="scroll-mt-24">
      <h2 class="text-3xl font-bold mb-8 flex items-center gap-3 text-lab-blue">
        <Mail className="w-8 h-8" />
        {pageData.visit.title}
      </h2>

      <div class="bg-white rounded-xl shadow-sm p-8 border border-gray-100">
        <p class="text-lg text-gray-700 mb-8">{pageData.visit.description}</p>

        <div class="w-full aspect-[4/3] md:aspect-[16/9] bg-gray-100 rounded-lg overflow-hidden border border-gray-200">
          {/* Google Form Placeholder */}
          <!-- <div class="w-full h-full flex items-center justify-center flex-col gap-4 text-gray-400">
            {
              pageData.visit.form_url ? (
                <iframe
                  src={pageData.visit.form_url}
                  width="100%"
                  height="100%"
                  frameborder="0"
                  marginheight="0"
                  marginwidth="0"
                >
                  Loading...
                </iframe>
              ) : (
                <>
                  <p class="font-medium">Google Form 埋め込みエリア</p>
                  <p class="text-sm">src/data/join.json でフォームURLを設定してください</p>
                </>
              )
            }
          </div> -->
        </div>
      </div>
    </section>
    <!-- */} -->
  </div>
</Layout>

