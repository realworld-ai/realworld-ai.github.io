---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import joinData from "../../data/join.json";
import { UserPlus, Mail } from "lucide-react";

const lang = "ja";
const pageData = joinData[lang];
---

<Layout title="採用情報・見学 | Real-world Intelligence Lab" lang={lang}>
  <div class="pt-32 pb-20 max-w-7xl mx-auto px-4 py-16 space-y-20">
    <PageHeader title="採用情報・見学" subtitle="当研究室への参加や、見学・共同研究について" />

    <!-- Recruitment Section -->
    <section id="recruitment" class="scroll-mt-24">
      <h2 class="text-3xl font-bold mb-8 flex items-center gap-3 text-lab-blue">
        <UserPlus className="w-8 h-8" />
        {pageData.recruitment.title}
      </h2>

      <div class="">
        <p class="text-lg text-gray-400 mb-6">{pageData.recruitment.description}</p>

        {
          pageData.recruitment.jobs && pageData.recruitment.jobs.length > 0 ? (
            <div class="space-y-8">
              {pageData.recruitment.jobs.map((job) => (
                <div class="border-l-4 border-lab-blue p-6 bg-gray-50/5 border border-gray-700/30 rounded-r-lg hover:bg-gray-800/20 transition-colors">
                  <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2 mb-4">
                    <h3 class="text-xl font-bold text-white">{job.title}</h3>
                    {job.number && (
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-lab-blue/10 text-lab-blue border border-lab-blue/20">
                        採用予定人数: {job.number}
                      </span>
                    )}
                  </div>
                  
                  <div class="space-y-4 text-gray-300">
                    {Array.isArray(job.description) ? (
                      job.description.map((desc) => <p class="leading-relaxed">{desc}</p>)
                    ) : (
                      <p class="leading-relaxed">{job.description}</p>
                    )}
                  </div>

                  {job.attachment && (
                    <div class="mt-6 pt-4 border-t border-gray-700/50">
                      <a 
                        href={job.attachment}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 text-lab-blue hover:text-lab-blue/80 transition-colors bg-lab-blue/5 hover:bg-lab-blue/10 px-4 py-2 rounded-lg"
                      >
                        <UserPlus className="w-4 h-4" />
                        募集要項 (PDF)
                      </a>
                    </div>
                  )}
                </div>
              ))}
            </div>
          ) : (
            <div class="text-center py-12 bg-gray-800 rounded-lg border border-dashed border-gray-700">
              <p class="text-gray-500 italic text-lg">{pageData.recruitment.no_openings}</p>
            </div>
          )
        }
      </div>
    </section>

    <!-- Visit / Collaboration Section -->
    <section id="contact" class="scroll-mt-24">
      <h2 class="text-3xl font-bold mb-8 flex items-center gap-3 text-lab-blue">
        <Mail className="w-8 h-8" />
        {pageData.visit.title}
      </h2>

      <div class="bg-white rounded-xl shadow-sm p-8 border border-gray-100">
        <p class="text-lg text-gray-700 mb-8">{pageData.visit.description}</p>

        <div class="w-full aspect-[4/3] md:aspect-[16/9] bg-gray-100 rounded-lg overflow-hidden border border-gray-200">
          {/* Google Form Placeholder */}
          <div class="w-full h-full flex items-center justify-center flex-col gap-4 text-gray-400">
            {
              pageData.visit.form_url ? (
                <iframe
                  src={pageData.visit.form_url}
                  width="100%"
                  height="100%"
                  frameborder="0"
                  marginheight="0"
                  marginwidth="0"
                >
                  読み込み中...
                </iframe>
              ) : (
                <>
                  <p class="font-medium">Google Form 埋め込みエリア</p>
                  <p class="text-sm">src/data/join.json を更新してフォームのURLを設定してください</p>
                </>
              )
            }
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
